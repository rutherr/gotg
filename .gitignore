# .gitignore
node_modules/

# secrets -- never commit real values, only .env.example
.env
.env.*
!.env.example

# SQLite data (users/sessions) -- see server/db.js note on Railway Volumes
data/
*.db
*.db-shm
*.db-wal

# generated build output -- regenerated by `npm run generate-assets` and
# `npm run build:css` (also run automatically in the Dockerfile)
public/assets/pieces/
public/css/output.css

# editor/OS noise
.DS_Store
*.log
